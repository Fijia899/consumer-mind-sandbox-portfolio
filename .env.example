# Copy to .env and fill in your private API key. Never commit .env.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Optional: reuse another local configuration file for missing values.
MANCHUANG_ENV_FILE=
# Optional local speech model (small is multilingual; first use downloads weights).
TRAVEL_ASR_MODEL=small
